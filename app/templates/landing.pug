    script(src='https://maps.googleapis.com/maps/api/js?key=AIzaSyCjCGmQ0Uq4exrzdcL6rvxywDDOvfAu6eE')
    script(src='/landing/js/gmaps.min.js')
    // contact js
    script(src='/landing/js/jquery.form.js')
    script(src='/landing/js/jquery.validate.min.js')
    script(src='/landing/js/contact.js')

    script(src='/landing/js/theme.js')
